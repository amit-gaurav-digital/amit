NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://localhost:27017/ai-blogging

OPENAI_API_KEY=your_openai_api_key_here

WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=wordpress_username
WORDPRESS_PASSWORD=wordpress_app_password

JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_MIN_LENGTH=12

REDIS_URL=redis://localhost:6379

DALLE_API_KEY=your_openai_api_key_here

LINKEDIN_ACCESS_TOKEN=your_linkedin_token
LINKEDIN_USER_ID=your_linkedin_user_id

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=notifications@blogging-platform.com

FRONTEND_URL=http://localhost:3000
ENABLE_USER_REGISTRATION=false
DEFAULT_USER_ROLE=viewer

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/oauth/callback

# Encryption Configuration
ENCRYPTION_KEY=your_encryption_key_32_bytes_base64_encoded
